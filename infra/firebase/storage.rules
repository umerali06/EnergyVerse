rules_version = '2';

// Storage is server-mediated via the Admin SDK for everything except
// inspection media (mirrors D-002's Firestore precedent). Company logos and
// asset media are served through short-lived signed URLs generated by the
// API, not public objects, and are never written by a client directly.
//
// Phase 7.4 (D-0xx) carves out ONE exception: inspection media (photos and
// videos) is written directly from the mobile client straight to Storage,
// since proxying a multi-minute 1080p video through the backend would
// double the network hop and risk stalling the lightweight inspection-record
// sync. The rule below only verifies company membership from the Firebase
// custom-claims token -- it cannot check the finer-grained `inspections.write`
// permission (that's resolved server-side from Firestore, not present in the
// token) or that `inspectionId` refers to a real inspection. Both gaps are
// accepted by design: the object is inert until the backend's attach
// endpoint (which DOES enforce `inspections.write` and real-inspection
// lookup) registers a reference to it, so an unreferenced write is a
// harmless orphan, never a readable/usable resource on its own -- reads stay
// signed-URL-only via the backend, never direct from a client.
service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/inspections/{inspectionId}/media/{fileName} {
      allow create: if request.auth != null
                    && request.auth.token.company_id == companyId
                    && request.resource.size < 500 * 1024 * 1024;
      allow update, delete: if false;
      allow read: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
