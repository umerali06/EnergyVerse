{
  "family": "fev-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::482881544977:role/fevApiTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::482881544977:role/fevApiTaskRole",
  "containerDefinitions": [
    {
      "name": "fev-api",
      "image": "482881544977.dkr.ecr.us-east-1.amazonaws.com/fev-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "FEV_DEBUG",
          "value": "false"
        },
        {
          "name": "FIREBASE_PROJECT_ID",
          "value": "thinking-case-469504-c0"
        },
        {
          "name": "FIREBASE_STORAGE_BUCKET",
          "value": "thinking-case-469504-c0.firebasestorage.app"
        },
        {
          "name": "APP_BASE_URL",
          "value": "https://www.flacronenergy.com"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "[\"https://www.flacronenergy.com\",\"https://main.dyjbtwzmsrdvr.amplifyapp.com\"]"
        },
        {
          "name": "CORS_ALLOW_ALL_LOCALHOST",
          "value": "false"
        },
        {
          "name": "AI_VISION_MODEL",
          "value": "claude-sonnet-5"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "SES_FROM_EMAIL",
          "value": "no-reply@flacronenterprises.com"
        },
        {
          "name": "SES_FROM_NAME",
          "value": "Flacron EnergyVerse"
        },
        {
          "name": "PUSH_NOTIFICATIONS_ENABLED",
          "value": "true"
        },
        {
          "name": "STRIPE_SUCCESS_PATH",
          "value": "/signup/complete"
        },
        {
          "name": "STRIPE_CANCEL_PATH",
          "value": "/signup"
        }
      ],
      "secrets": [
        {
          "name": "FIREBASE_CREDENTIALS_B64",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:FIREBASE_CREDENTIALS_B64::"
        },
        {
          "name": "FIREBASE_WEB_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:FIREBASE_WEB_API_KEY::"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:ANTHROPIC_API_KEY::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_PUBLISHABLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:STRIPE_PUBLISHABLE_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:STRIPE_WEBHOOK_SECRET::"
        },
        {
          "name": "SEED_DEMO_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:482881544977:secret:fev/api-FPkQs5:SEED_DEMO_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fev-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}