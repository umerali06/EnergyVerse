{
  "_comment": [
    "ECS Fargate task definition for the FEV API.",
    "",
    "Placeholders marked <LIKE_THIS> must be replaced once, when you first",
    "register this in your AWS account. The deploy workflow then rewrites only",
    "the image field on every push, so this file stays the source of truth for",
    "everything else.",
    "",
    "Secrets are pulled from AWS Secrets Manager by the ECS agent at start-up",
    "and never appear in this file, in the repository, or in the task's",
    "environment block. That is the point of splitting environment from",
    "secrets below."
  ],
  "family": "fev-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fevApiTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fevApiTaskRole",
  "containerDefinitions": [
    {
      "name": "fev-api",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/fev-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "FEV_DEBUG",
          "value": "false"
        },
        {
          "name": "FIREBASE_PROJECT_ID",
          "value": "<FIREBASE_PROJECT_ID>"
        },
        {
          "name": "FIREBASE_STORAGE_BUCKET",
          "value": "<FIREBASE_PROJECT_ID>.firebasestorage.app"
        },
        {
          "name": "APP_BASE_URL",
          "value": "https://<YOUR_AMPLIFY_DOMAIN>"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "[\"https://<YOUR_AMPLIFY_DOMAIN>\"]"
        },
        {
          "name": "CORS_ALLOW_ALL_LOCALHOST",
          "value": "false"
        },
        {
          "name": "AI_VISION_MODEL",
          "value": "claude-sonnet-5"
        },
        {
          "name": "AWS_REGION",
          "value": "<REGION>"
        },
        {
          "name": "SES_FROM_EMAIL",
          "value": "<no-reply@yourdomain.com>"
        },
        {
          "name": "SES_FROM_NAME",
          "value": "Flacron EnergyVerse"
        },
        {
          "name": "PUSH_NOTIFICATIONS_ENABLED",
          "value": "true"
        },
        {
          "name": "STRIPE_SUCCESS_PATH",
          "value": "/signup/complete"
        },
        {
          "name": "STRIPE_CANCEL_PATH",
          "value": "/signup"
        }
      ],
      "secrets": [
        {
          "name": "FIREBASE_CREDENTIALS_B64",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:FIREBASE_CREDENTIALS_B64::"
        },
        {
          "name": "FIREBASE_WEB_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:FIREBASE_WEB_API_KEY::"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:ANTHROPIC_API_KEY::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:STRIPE_SECRET_KEY::"
        },
        {
          "name": "STRIPE_PUBLISHABLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:STRIPE_PUBLISHABLE_KEY::"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:STRIPE_WEBHOOK_SECRET::"
        },
        {
          "name": "SEED_DEMO_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:fev/api-XXXXXX:SEED_DEMO_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fev-api",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
